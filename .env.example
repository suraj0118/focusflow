# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusflow

# Auth
JWT_SECRET=focusflow-super-secret-key-2026-change-in-production
JWT_REFRESH_SECRET=focusflow-refresh-secret-key-2026-change-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# AI assistant removed. No AI environment variables are required.

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# CORS
WEB_URL=http://localhost:5173
MOBILE_URL=exp://localhost:8081

# Web app
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

