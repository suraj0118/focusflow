{
  "name": "focusflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @focusflow/server",
    "dev:web": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "test:server": "npm run test -w @focusflow/server",
    "test:web": "npm run test -w @focusflow/web",
    "test:mobile": "npm run test -w @focusflow/mobile",
    "test:server:watch": "npm run test:watch -w @focusflow/server",
    "db:migrate": "npm run db:migrate -w @focusflow/server",
    "db:generate": "npm run db:generate -w @focusflow/server",
    "db:studio": "npm run db:studio -w @focusflow/server",
    "db:seed": "npm run db:seed -w @focusflow/server"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.0"
  }
}
